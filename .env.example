# Example environment variables for the Job Portal frontend (Vite)
# Copy this file to `.env.local` (for local development) and fill in your keys.
# Never commit real secrets to version control. `.env.local` should be gitignored by default.

# Supabase project URL (from Supabase settings)
VITE_SUPABASE_URL=

# Supabase anon/public key (from Supabase settings)
VITE_SUPABASE_ANON_KEY=

# Clerk publishable key (starts with pk_test_ or pk_live_)
VITE_CLERK_PUBLISHABLE_KEY=

# Usage:
# 1) Copy this file to .env.local in the project root
#    Windows PowerShell example:
#    Copy-Item -Path .env.example -Destination .env.local
# 2) Paste your keys after the equals signs
# 3) Restart your dev server: e.g., `npm run dev` or `yarn dev`
